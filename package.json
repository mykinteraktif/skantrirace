{
  "name": "skantri-race",
  "private": true,
  "version": "1.2.0",
  "description": "SKANTRI RACE — game balap mobil 3D arcade berbasis Three.js (1–2 pemain: layar terbagi atau online 2 perangkat)",
  "author": "Mohammad Yusron Kholish, S.Kom (SMKS PGRI SINGOSARI)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --outDir docs --emptyOutDir && node -e \"require('fs').writeFileSync('docs/.nojekyll','')\"",
    "preview": "vite preview",
    "test": "node --test tests/logic.test.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "test:online": "node tests/online.test.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "peerjs": "^1.5.5",
    "qrcode-generator": "^2.0.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
